# Salin ke .env.local (tidak pernah di-commit). Production memakai env var Vercel.
# Dev dan production WAJIB memakai database Upstash dan API key yang berbeda.

# "development" (lokal) atau "production" (Vercel). Menentukan awalan kunci Redis.
APP_ENV=development

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Diisi pada tahap berikutnya:
# ANTHROPIC_API_KEY=
# SESSION_SECRET=
# BLOB_READ_WRITE_TOKEN=
# OPENAI_API_KEY=

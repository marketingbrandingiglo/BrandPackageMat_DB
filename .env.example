# Salin ke .env.local (tidak pernah di-commit). Production memakai env var Vercel.
# Dev dan production memakai database Upstash yang sama (keputusan pemilik,
# SPEC bagian 18) dan dipisahkan oleh prefiks kunci: bpa:dev: dan bpa:prod:.

# Lokal: "development". Di Vercel tidak perlu diisi; VERCEL_ENV dipakai otomatis.
APP_ENV=development

# Upstash Redis (REST) — nama sama dengan yang dibuat integrasi Upstash di Vercel.
# Salin nilainya dari konsol Upstash (Details > REST API), jangan ditempel ke chat.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kunci tanda tangan cookie sesi, minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nilai lokal dan production HARUS berbeda (production diisi di env var Vercel).
SESSION_SECRET=

# Bel sesi pekerja Claude (SPEC bagian 8): token GitHub fine-grained khusus repo ini,
# izin Issues + Pull requests: Read and write. Jangan ditempel ke chat.
GITHUB_TOKEN=
GITHUB_REPO=marketingbrandingiglo/BrandPackageMat_DB
CONTROL_PR=1

# Google Drive (penyimpanan logo dan hasil). OAuth client tipe "Web application" dari Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kunci enkripsi token Drive di Upstash, minimal 32 karakter acak (cara buat sama dengan SESSION_SECRET).
# Nilainya HARUS sama di lokal, Vercel, dan environment sesi pekerja (satu sambungan Drive dipakai bersama).
DRIVE_TOKEN_SECRET=

# Production saja (Vercel): rahasia untuk job pembersihan harian /api/cron/cleanup (minimal 16 karakter acak).
# Vercel Cron mengirimnya otomatis sebagai header Authorization.
# CRON_SECRET=

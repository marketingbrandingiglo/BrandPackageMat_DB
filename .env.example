# Salin ke .env.local (tidak pernah di-commit). Production memakai env var Vercel.
# Dev dan production memakai database Upstash yang sama (keputusan pemilik,
# SPEC bagian 18) dan dipisahkan oleh prefiks kunci: bpa:dev: dan bpa:prod:.

# Lokal: "development". Di Vercel tidak perlu diisi; VERCEL_ENV dipakai otomatis.
APP_ENV=development

# Upstash Redis (REST) — nama sama dengan yang dibuat integrasi Upstash di Vercel.
# Salin nilainya dari konsol Upstash (Details > REST API), jangan ditempel ke chat.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kunci tanda tangan cookie sesi, minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nilai lokal dan production HARUS berbeda (production diisi di env var Vercel).
SESSION_SECRET=

# Claude API (Tahap 3d dst.). Cara membuat key: docs/claude.md. Jangan ditempel ke chat.
ANTHROPIC_API_KEY=
# Opsional, default di lib/ai/claude.ts:
# CLAUDE_MODEL_MAIN=claude-opus-5-5
# CLAUDE_MODEL_LIGHT=claude-haiku-5-5

# Diisi pada tahap berikutnya:
# BLOB_READ_WRITE_TOKEN=
# OPENAI_API_KEY=

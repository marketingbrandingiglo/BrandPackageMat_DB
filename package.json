    "@xmldom/xmldom": "^0.9.12",
    "next": "16.4.6",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
